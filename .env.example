# Copie para .env (cp .env.example .env) e preencha.
# Os nomes e padrões vêm de src/main/resources/application.properties.
# O Spring lê este arquivo como .properties: um valor por linha, sem aspas.

# Porta publicada pelo docker-compose.yml.
APP_PORT=8080
# Porta HTTP da aplicação (padrão 9654; a imagem Docker usa 8080).
# SERVER_PORT=9654

# ---------------------------------------------------------------------------
# Banco PostgreSQL com o schema do EcoCiente já criado (ddl-auto=validate).
# No Docker, troque localhost por host.docker.internal.
DB_URL=jdbc:postgresql://localhost:5432/ecociente
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Segredo HMAC que assina e valida os JWT (mínimo de 32 bytes).
# Gere com: openssl rand -base64 32
JWT_SECRET=
# Validade do token em milissegundos.
# JWT_EXPIRATION_MS=300000
# Origens permitidas no CORS, separadas por vírgula.
# CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Firebase: conteúdo JSON da conta de serviço, em uma linha (não o caminho do arquivo).
FIREBASE_CREDENCIAIS=

# ---------------------------------------------------------------------------
# SMTP para o código de recuperação de senha (STARTTLS obrigatório).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Redis (saldos e rankings). No Docker, troque localhost por host.docker.internal.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Data inicial dos ciclos de ranking (yyyy-MM-dd).
RANKING_CYCLE_EPOCH=2026-01-01

# ---------------------------------------------------------------------------
# Validador de fotos (CLIP local em ONNX Runtime).
# false desliga a triagem automática; aí HOSTS_PERMITIDOS e CLIP_DIR não são usados.
VALIDADOR_ATIVO=true
# Hosts de onde a foto pode ser baixada, separados por vírgula (anti-SSRF).
HOSTS_PERMITIDOS=localhost
# Pasta com vision_model.onnx, text_model.onnx e tokenizer.json.
CLIP_DIR=modelos/clip-vit-base-patch32
LIMIAR_CONFIANCA=0.5
# Opcionais: zona de revisão humana e limiar por categoria.
# LIMIAR_REVISAO=0.3
# LIMIARES_POR_CATEGORIA={"vidro": 0.6}
# MAX_PEDIDOS_SIMULTANEOS=8
# TAMANHO_MAXIMO_BYTES=10000000
# TIMEOUT_DOWNLOAD_SEGUNDOS=10

# ---------------------------------------------------------------------------
# false desliga os jobs de fechamento das validações e de sincronização do Redis.
# APP_JOBS_ENABLED=true
