APP_PORT=8080

# Banco PostgreSQL com o schema do EcoCiente já criado (ddl-auto=validate).
DB_URL=jdbc:postgresql://localhost:5432/ecociente
DB_USERNAME=
DB_PASSWORD=

# Segredo HMAC usado para validar os JWT. Deve ser o mesmo do serviço que emite os tokens.
JWT_SECRET=

# URL da API de pontuação, sem o caminho dos endpoints.
PONTUACAO_BASE_URL=http://localhost:9786

# JWT de serviço aceito pela pontuação com perfil SERVICE ou ADMIN.
# Informar sem "Bearer". Não é o JWT_SECRET.
PONTUACAO_TOKEN_SERVICO=

# URL da ds-validador-postagens-api, sem o caminho dos endpoints.
VALIDADOR_BASE_URL=http://localhost:8000

# Mesmo valor do CHAVE_API do validador (enviado no header X-Api-Key).
VALIDADOR_CHAVE_API=
